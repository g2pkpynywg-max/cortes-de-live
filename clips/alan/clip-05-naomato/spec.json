 "captions": [
  {
   "s": "2:36:03.96",
   "e": "2:36:04.85",
   "t": "Desabilitei! Você viu?",
   "kw": [
    "Desabilitei"
   ]
  },
  {
   "s": "2:36:04.90",
   "e": "2:36:05.80",
   "t": "Eu não matei ele!",
   "kw": [
    "não",
    "matei"
   ]
  },
  {
   "s": "2:36:05.84",
   "e": "2:36:07.55",
   "t": "Olha lá, ele ficou com o joelho doendo!",
   "kw": [
    "joelho"
   ]
  },
  {
   "s": "2:36:07.60",
   "e": "2:36:11.60",
   "t": "Mano, eu não mato ninguém nesse jogo, mano.",
   "kw": [
    "ninguém"
   ]
  },
  {
   "s": "4:01:03.51",
   "e": "4:01:05.45",
   "t": "Hostil? Eu não sou hostil!",
   "kw": [
    "hostil"
   ]
  },
  {
   "s": "4:01:05.49",
   "e": "4:01:07.10",
   "t": "Eu dei um tiro na perna dele, cara.",
   "kw": [
    "perna"
   ]
  },
  {
   "s": "4:01:07.17",
   "e": "4:01:10.10",
   "t": "Isso é hostil?",
   "kw": [
    "hostil"
   ]
  },
  {
   "s": "4:01:10.18",
   "e": "4:01:12.90",
   "t": "Meu perfil foi para hostil, mano.",
   "kw": [
    "hostil"
   ]
  },
  {
   "s": "4:01:13.00",
   "e": "4:01:15.40",
   "t": "Eu não matei ele, mano!",
   "kw": [
    "não",
    "matei"
   ]
  },
  {
   "s": "4:01:15.48",
   "e": "4:01:16.90",
   "t": "Isso não é matar, cara.",
   "kw": [
    "matar"
   ]
  },
  {
   "s": "10:50:38.57",
   "e": "10:50:43.35",
   "t": "Eu não mato ninguém, cara, eu sou um cara honesto.",
   "kw": [
    "honesto"
   ]
  },
  {
   "s": "10:50:43.41",
   "e": "10:50:45.60",
   "t": "O cara tá vivo, ele só desmaiou.",
   "kw": [
    "desmaiou"
   ]
  },
  {
   "s": "10:50:45.65",
   "e": "10:50:47.10",
   "t": "O jogo mesmo falou: não letal.",
   "kw": [
    "não",
    "letal"
   ]
  },
  {
   "s": "10:50:55.95",
   "e": "10:50:58.10",
   "t": "Tem mais droga por aqui pra gente pegar?",
   "kw": [
    "droga"
   ]
  },
  {
   "s": "10:50:58.17",
   "e": "10:50:59.10",
   "t": "Mano, tem mais uma aqui.",
   "kw": [
    "mais",
    "uma"
   ]
  },
  {
   "s": "12:25:39.77",
   "e": "12:25:41.65",
   "t": "Eu não tenho essa vibe, mano.",
   "kw": [
    "vibe"
   ]
  },
  {
   "s": "12:25:41.69",
   "e": "12:25:44.20",
   "t": "Eu tenho quase 40 anos, mano.",
   "kw": [
    "40",
    "anos"
   ]
  },
  {
   "s": "12:25:44.23",
   "e": "12:25:47.45",
   "t": "Eu não fico mais matando geral, velho.",
   "kw": [
    "matando",
    "geral"
   ]
  },
  {
   "s": "12:25:47.53",
   "e": "12:25:49.40",
   "t": "Matava geral quando eu tinha uns 12 anos, mano.",
   "kw": [
    "12",
    "anos"
   ]
  },
  {
   "s": "13:52:58.65",
   "e": "13:53:00.20",
   "t": "Eu não tô matando ninguém, mano.",
   "kw": [
    "ninguém"
   ]
  },
  {
   "s": "13:53:00.23",
   "e": "13:53:01.70",
   "t": "Quem tá falando que eu tô matando tá viajando.",
   "kw": [
    "viajando"
   ]
  },
  {
   "s": "13:53:16.93",
   "e": "13:53:19.60",
   "t": "Tô matando alguns, vai, não dá pra mentir também, né.",
   "kw": [
    "alguns"
   ]
  },
  {
   "s": "13:54:11.51",
   "e": "13:54:14.00",
   "t": "É chato… eu matei umas pessoas mesmo.",
   "kw": [
    "matei",
    "pessoas"
   ]
  }
 ]
}