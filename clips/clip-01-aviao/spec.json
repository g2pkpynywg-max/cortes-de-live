  "captions": [
    { "s": "2:03:06.20", "e": "2:03:07.95", "t": "Mesmo com todo esse realismo,", "kw": ["realismo"] },
    { "s": "2:03:08.00", "e": "2:03:09.40", "t": "dá pra roubar um avião!", "kw": ["avião"] },
    { "s": "2:03:09.42", "e": "2:03:11.60", "t": "Mesmo a gente morrendo!", "kw": ["morrendo"] },
    { "s": "2:03:11.66", "e": "2:03:14.45", "t": "Acho que a gente não vai sair do ar…" },
    { "s": "2:03:14.52", "e": "2:03:16.35", "t": "quer dizer, pro ar.", "kw": ["pro", "ar"] },
    { "s": "2:03:16.42", "e": "2:03:18.40", "t": "Não, a gente já era.", "kw": ["já", "era"] },
    { "s": "2:03:22.50", "e": "2:03:24.90", "t": "Sobe! Ai, caramba,", "kw": ["sobe"] },
    { "s": "2:03:24.94", "e": "2:03:27.40", "t": "pera, esse avião é um tanque", "kw": ["tanque"] },
    { "s": "2:03:38.86", "e": "2:03:40.45", "t": "Ei, tamo na pista!", "kw": ["pista"] },
    { "s": "2:03:40.48", "e": "2:03:43.30", "t": "Vai, avião, vai!", "kw": ["vai"] },
    { "s": "2:03:47.40", "e": "2:03:48.28", "t": "Sobe!", "kw": ["sobe"] },
    { "s": "2:03:48.30", "e": "2:03:50.48", "t": "Pronto. Saímos do chão.", "kw": ["chão"] },
    { "s": "2:03:50.52", "e": "2:03:52.70", "t": "Ah, o avião tá sem rodas, viu.", "kw": ["rodas"] },
    { "s": "2:03:52.74", "e": "2:03:56.00", "t": "A gente perdeu o trem de pouso.", "kw": ["trem", "pouso"] },
    { "s": "2:03:58.48", "e": "2:03:59.85", "t": "Beleza." },
    { "s": "2:03:59.90", "e": "2:04:02.60", "t": "A gente conseguiu mesmo…", "kw": ["conseguiu"] },
    { "s": "2:04:02.88", "e": "2:04:04.10", "t": "Não acredito…" },
    { "s": "2:04:04.18", "e": "2:04:05.60", "t": "Não acredito que a gente" },
    { "s": "2:04:05.62", "e": "2:04:07.20", "t": "tirou esse avião do chão!", "kw": ["avião", "chão"] }
  ]
